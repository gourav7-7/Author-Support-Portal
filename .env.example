# Copy this file to .env in the project root. Never commit .env.
APP_ENV=development
# Blank = a persistent SQLite database in backend/data/bookleaf.db.
DATABASE_URL=
# Blank in development generates a persistent, ignored .local-secret file.
# For public deployment, set a random value of at least 32 characters.
JWT_SECRET=
TOKEN_EXPIRE_MINUTES=480
AUTO_SEED=true
ADMIN_EMAIL=admin@authorcare.demo
DEMO_AUTHOR_PASSWORD=AuthorDemo!2026
DEMO_ADMIN_PASSWORD=AdminDemo!2026
# Optional for local review; REQUIRED to demonstrate actual LLM integration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12
# Only needed for direct cross-origin API access. Vite proxies /api locally.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A directory built by npm run build; Docker supplies this automatically.
FRONTEND_DIST=
